{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/codex/run.cmd\" codex",
            "timeout": 120,
            "statusMessage": "Scoring tool output with Jev"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/codex/run.cmd\" codex",
            "timeout": 30,
            "statusMessage": "Restoring tool output Jev kept"
          }
        ]
      }
    ]
  }
}
